generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model Listing {
  id            String    @id @default(cuid())
  title         String
  price         Int?
  category      String
  neighborhood  String
  description   String
  image         String?
  contact       String
  createdAt     DateTime  @default(now())
}
